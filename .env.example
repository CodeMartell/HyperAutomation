# ============================================
# HyperAutomation — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha
# com suas credenciais reais:
#   cp .env.example .env
# ============================================

# --- Configurações de E-mail ---
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA=sua_senha_de_app
EMAIL_DESTINATARIO=destinatario@email.com

# --- Servidor SMTP ---
# Para Gmail: smtp.gmail.com / 587
# Para Outlook: smtp-mail.outlook.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Portal Fake ---
# URL do Portal Fake (HTML local).
# Deixe em branco para usar o portal_fake/ incluído no repositório.
# PORTAL_FAKE_URL=file:///caminho/personalizado/portal_fake/index.html

# ============================================
# Processo 1 — Setor de Atendimento (IMAP)
# ============================================
# Credenciais para LEITURA de e-mails via IMAP.
# Pode reutilizar a mesma conta Gmail do EMAIL_REMETENTE.
# Para Gmail, use a mesma Senha de App gerada para o SMTP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Se não definido, usa EMAIL_REMETENTE como fallback:
IMAP_USER=seuemail@gmail.com
# Se não definido, usa EMAIL_SENHA como fallback:
IMAP_PASSWORD=sua_senha_de_app
# Filtro de assunto (opcional): somente e-mails cujo assunto contenha
# essa palavra serão processados. Deixe vazio para aceitar qualquer assunto
# (desde que tenha anexo). Exemplo: IMAP_FILTRO_ASSUNTO=atendimento
# IMAP_FILTRO_ASSUNTO=atendimento
# Limite de e-mails processados por execução (padrão: 50 mais recentes)
# Útil quando há muitos e-mails não lidos na caixa.
IMAP_MAX_EMAILS=50

# --- Google Drive Integration (ERP) ---
# Defina como True para salvar e classificar arquivos no Google Drive (ERP_Portal_Fake/).
# Deixe False para rodar com o sistema de arquivos local.
# Se True, você precisa do arquivo credentials.json na raiz do projeto.
USAR_GOOGLE_DRIVE=False

